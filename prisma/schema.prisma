// Prisma schema (docs/DATA_MODEL.md §1, §3).
// Connection URLs live in prisma.config.ts (Prisma 7).
// Timestamps are UTC timestamptz; pickup dates are plain `date` (a Chicago calendar day).
// Money is integer US cents. CHECK constraints live in the migration SQL.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CapacityMode {
  DOUGH_PER_UNIT
  DOUGH_PER_ROUND
  INDEPENDENT
}

enum ProductStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum OrderStatus {
  NEW
  CONTACTED
  CONFIRMED
  BAKING
  READY
  COMPLETED
  CANCELLED
  REJECTED
}

enum Fulfillment {
  PICKUP
  DELIVERY
}

enum OrderSource {
  WEB
  ADMIN
}

enum PaidMethod {
  WECHAT
  ZELLE
  VENMO
  CASH
  OTHER
}

enum CancelledBy {
  CUSTOMER
  ADMIN
}

enum Actor {
  ADMIN
  CUSTOMER
  SYSTEM
}

enum NotificationKind {
  NEW_ORDER
  CUSTOMER_CANCELLED
  DAILY_SUMMARY
  PASSWORD_RESET
  GAME_WINNER
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

/// Single row (CHECK id = 1).
model Setting {
  id                   Int      @id @default(1)
  orderingEnabled      Boolean  @default(false)
  cutoffTime           String   @default("20:00")
  defaultDoughLimitG   Int      @default(1600)
  defaultDeliveryLimit Int      @default(8)
  deliveryFeeCents     Int      @default(500)
  freeDeliveryMinCents Int      @default(2500)
  maxQtyPerItem        Int      @default(8)
  ownerWechatId        String   @default("")
  showWechatOnHome     Boolean  @default(false)
  pickupNote           String   @default("自提时间在下午 5 点以后，具体时间微信确认")
  bakingTextBread      String   @default("正在为你制作大面包！")
  bakingTextOther      String   @default("正在为你制作布蕾！")
  updatedAt            DateTime @default(now()) @updatedAt @db.Timestamptz(3)
}

model Product {
  id               String        @id @default(uuid()) @db.Uuid
  name             String
  description      String        @default("")
  imageUrl         String?
  /// Home background colour `#RRGGBB` (D95); null = default 奶白. ink/ink2 are derived (src/lib/fieldColor.ts).
  fieldColor       String?
  unitPriceCents   Int
  bundleSize       Int           @default(4)
  bundlePriceCents Int?
  capacityMode     CapacityMode
  doughG           Int?
  roundG           Int?
  piecesPerRound   Int?
  dailyLimit       Int?
  batchYield       Int?
  leadDays         Int           @default(1)
  /// D115: weekdays (0 = Sunday … 6 = Saturday, Chicago pickup date) it can be picked up on.
  /// Sorted, distinct, never all seven; [] = every day.
  pickupWeekdays   Int[]         @default([])
  status           ProductStatus @default(ACTIVE)
  sortOrder        Int           @default(0)
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime      @default(now()) @updatedAt @db.Timestamptz(3)

  dateLimits  OpenDateProductLimit[]
  orderItems  OrderItem[]
  manualItems ManualIncomeItem[]
  gameTiers   GameTier[]
  images      ProductImage[]
}

/// Product photos in display order, cover = sortOrder 0 (D98). Product.imageUrl mirrors the cover.
model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  url       String
  sortOrder Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model OpenDate {
  date            DateTime @id @db.Date
  isOpen          Boolean  @default(true)
  doughLimitG     Int?
  deliveryEnabled Boolean  @default(true)
  deliveryLimit   Int?
  note            String?
  /// Highest order seq handed out for this date (src/server/seq.ts); never decreases.
  lastSeq         Int      @default(0)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  productLimits OpenDateProductLimit[]
  orders        Order[]
}

model OpenDateProductLimit {
  date      DateTime @db.Date
  productId String   @db.Uuid
  limit     Int

  openDate OpenDate @relation(fields: [date], references: [date], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([date, productId])
}

model Order {
  id               String       @id @default(uuid()) @db.Uuid
  pickupDate       DateTime     @db.Date
  seq              Int
  orderNo          String
  viewToken        String       @unique
  wechatId         String
  fulfillment      Fulfillment
  status           OrderStatus  @default(NEW)
  subtotalCents    Int
  deliveryFeeCents Int
  totalCents       Int
  note             String?
  cutoffAt         DateTime     @db.Timestamptz(3)
  source           OrderSource
  paid             Boolean      @default(false)
  paidMethod       PaidMethod?
  paidAt           DateTime?    @db.Timestamptz(3)
  idempotencyKey   String?      @unique
  ipHash           String?
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime     @default(now()) @updatedAt @db.Timestamptz(3)
  confirmedAt      DateTime?    @db.Timestamptz(3)
  cancelledAt      DateTime?    @db.Timestamptz(3)
  cancelledBy      CancelledBy?

  openDate OpenDate    @relation(fields: [pickupDate], references: [date], onDelete: Restrict)
  items    OrderItem[]

  @@unique([pickupDate, seq])
  @@index([pickupDate, status])
  @@index([wechatId, pickupDate])
  @@index([createdAt(sort: Desc)])
}

model OrderItem {
  id               String @id @default(uuid()) @db.Uuid
  orderId          String @db.Uuid
  productId        String @db.Uuid
  nameSnapshot     String
  qty              Int
  unitPriceCents   Int
  bundleSize       Int
  bundlePriceCents Int?
  lineTotalCents   Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  at         DateTime @db.Timestamptz(3)
  actor      Actor
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  reason     String?

  @@index([entityType, entityId])
  @@index([at(sort: Desc)])
}

/// Outbox: enqueued in the same transaction as the business write, sent afterwards.
model Notification {
  id            String             @id @default(uuid()) @db.Uuid
  kind          NotificationKind
  dedupeKey     String             @unique
  payload       Json
  status        NotificationStatus @default(PENDING)
  attempts      Int                @default(0)
  lastError     String?
  nextAttemptAt DateTime           @db.Timestamptz(3)
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)
  sentAt        DateTime?          @db.Timestamptz(3)

  @@index([status, nextAttemptAt])
}

model AdminUser {
  id           String    @id @default(uuid()) @db.Uuid
  username     String    @unique
  passwordHash String
  failedCount  Int       @default(0)
  lockedUntil  DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @default(now()) @updatedAt @db.Timestamptz(3)

  sessions       AdminSession[]
  passwordResets PasswordReset[]
}

model AdminSession {
  id         String   @id @default(uuid()) @db.Uuid
  /// sha256 of the random cookie value; the raw value is never stored.
  tokenHash  String   @unique
  userId     String   @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime @db.Timestamptz(3)
  lastSeenAt DateTime @db.Timestamptz(3)

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique
  userId    String    @db.Uuid
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RateLimitHit {
  id  BigInt   @id @default(autoincrement())
  key String
  at  DateTime @db.Timestamptz(3)

  @@index([key, at])
}

/// Hand-entered income for bookkeeping (D87).
model ManualIncome {
  id          String     @id @default(uuid()) @db.Uuid
  date        DateTime   @db.Date
  amountCents Int
  note        String
  paidMethod  PaidMethod
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime   @default(now()) @updatedAt @db.Timestamptz(3)

  items ManualIncomeItem[]

  @@index([date])
}

model ManualIncomeItem {
  id           String  @id @default(uuid()) @db.Uuid
  incomeId     String  @db.Uuid
  productId    String? @db.Uuid
  nameSnapshot String
  qty          Int

  income  ManualIncome @relation(fields: [incomeId], references: [id], onDelete: Cascade)
  product Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([incomeId])
  @@index([productId])
}

/// 消除大面包 (D100-D105). Owner-configured tiers, small to large; the isBig row is the 大面包.
model GameTier {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String?  @db.Uuid
  sortOrder Int      @default(0)
  imageUrl  String?
  /// Game-only piece name, or an override of the product's name (1-12 chars). NULL = the product's.
  name       String?
  /// Tier colour `#RRGGBB` (CHECK in the DB). NULL = the product's colour, else the preset cycle.
  fieldColor String?
  isBig     Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  /// productId NULL on a non-big row = a game-only piece (D107); deleting a product leaves one behind.
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([sortOrder])
  @@index([productId])
}

/// One play. Created by /api/game/start, verified and scored by /api/game/finish.
/// Which mini game a run / award belongs to: BIG = 消除大面包 (D100), TU = 兔了个兔 (D121).
enum GameKind {
  BIG
  TU
  M3
}

enum GamePrizeChosenBy {
  RANDOM
  OWNER
}

/// One prize game per Chicago week (D133); owner overrides keep the original creation time.
model GamePrizeWeek {
  weekKey   String            @id
  game      GameKind
  chosenBy  GamePrizeChosenBy
  createdAt DateTime          @default(now()) @db.Timestamptz(3)
}

model GameRun {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  game          GameKind  @default(BIG)
  seed          String
  wechatId      String
  nickname      String
  tiersSnapshot Json
  startedAt     DateTime  @default(now()) @db.Timestamptz(3)
  finishedAt    DateTime? @db.Timestamptz(3)
  score         Int?
  /// Evidence for the owner's manual check before awarding a prize (D103): the verified drop log,
  /// its length and the simulated length (steps of 1/120 s; seconds = simSteps / 120).
  drops         Json?
  dropCount     Int?
  simSteps      Int?
  /// TU only: the verified tap log is stored in `drops` (its length in `dropCount`); `playMs` is
  /// the last tap's client time (ms since start). `suspicious` flags a run for the owner's manual
  /// check before awarding (D103): it reached MAX_TAPS or its median tap gap is under 300 ms. It
  /// still counts on the board.
  playMs        Int?
  suspicious    Boolean   @default(false)
  /// Monday (Chicago) of the week the run was finished in, "YYYY-MM-DD".
  weekKey       String?
  ipHash        String?
  hidden        Boolean   @default(false)

  award GameAward[]

  @@index([game, weekKey, score(sort: Desc)])
  @@index([wechatId])
  @@index([startedAt])
}

/// Banned WeChat ids. Uniqueness is case-insensitive: see the lower("wechatId") index in the migration.
model GameBan {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wechatId  String
  reason    String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

/// The weekly winner's follow-up state (one per week).
model GameAward {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  game        GameKind  @default(BIG)
  weekKey     String
  runId       String    @db.Uuid
  contactedAt DateTime? @db.Timestamptz(3)
  redeemedAt  DateTime? @db.Timestamptz(3)
  note        String?

  run GameRun @relation(fields: [runId], references: [id], onDelete: Restrict)

  @@unique([game, weekKey])
  @@index([runId])
}

/// 小小🐰 assistant message counts per Chicago day (D118). ipHash '*' = the global row.
/// No message content is stored anywhere; rows of past days are deleted by the cleanup cron.
model AssistantUsage {
  day    DateTime @db.Date
  ipHash String
  count  Int      @default(0)

  @@id([day, ipHash])
}
